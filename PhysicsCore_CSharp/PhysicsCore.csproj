<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DSTU.VTVL</RootNamespace>
  </PropertyGroup>

  <!-- Исключаем UnityAdapters при сборке чистой математической библиотеки, так как они ссылаются на UnityEngine -->
